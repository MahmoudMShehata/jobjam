# Copy to .env (git-ignored) and fill in. The backend reads it on startup.

# AI extraction provider: "ollama" (free, local; the default) or "anthropic" (Claude API).
AI_PROVIDER=ollama
# OLLAMA_MODEL=qwen3-vl:8b-instruct

# Only needed with AI_PROVIDER=anthropic.
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# ANTHROPIC_MODEL=claude-haiku-5-5
